import tkinter as tk
from tkinter import ttk

def hasil_prediksi():
    for entry in entries:
        if entry.get() == "":
            hasil_label.config(text="Semua nilai mata pelajaran harus diisi!")
            return
            
    hasil_label.config(text="Hasil Prediksi: Teknologi Informasi")

root = tk.Tk()
root.title("Aplikasi Prediksi Prodi Pilihan")
root.geometry("500x600")
root.resizable(False, False)

judul = tk.Label(root, text="Aplikasi Prediksi Prodi Pilihan", font=("Arial", 16, "bold"))
judul.pack(pady=15)

input_frame = tk.Frame(root)
input_frame.pack(pady=5)

subjects = [
    "Matematika", "Bahasa Indonesia", "Bahasa Inggris", 
    "Algoritma", "Basis Data", "Pemrograman", 
    "Jaringan Komputer", "Sistem Operasi", "Statistika", "Kewirausahaan"
]
entries = []

for i, subject in enumerate(subjects):
    lbl = tk.Label(input_frame, text=f"Nilai {subject}:", anchor="w", width=18)
    lbl.grid(row=i, column=0, sticky="w", pady=4, padx=5)
    entry = ttk.Entry(input_frame, width=22)
    entry.grid(row=i, column=1, pady=4, padx=5)
    entries.append(entry)

prediksi_button = ttk.Button(root, text="Prediction Results", command=hasil_prediksi)
prediksi_button.pack(pady=15)

hasil_label = tk.Label(root, text="Hasil Prediksi: -", font=("Arial", 12, "bold"))
hasil_label.pack(pady=5)

root.mainloop()
